rules_version = '2';

// ASA Berea Storage rules.
// Images are public to read (they show on the website). Only signed-in admins
// (users carrying the custom claim admin == true) may upload, and only images
// up to 6 MB. Run `npm run set-admins` once to grant the claim to the emails
// in ADMIN_EMAILS.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
