# ASA Berea, environment variables. Copy this file to .env.local and fill in.
# Never commit .env.local. Only NEXT_PUBLIC_* values reach the browser.

# ---- Firebase web app config (Project settings > General > Your apps) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (Project settings > Service accounts > Generate key) ----
# Paste the whole service-account JSON on one line, or base64-encode it.
# Server-only. Never exposed to the browser.
FIREBASE_SERVICE_ACCOUNT=

# ---- Admin allowlist: comma-separated emails allowed into /admin ----
ADMIN_EMAILS=jallohosmanamadu311@gmail.com

# ---- Optional ----
NEXT_PUBLIC_INSTAGRAM_HANDLE=berea_asa
NEXT_PUBLIC_STORE_CHECKOUT_BASE=
